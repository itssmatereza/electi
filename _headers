# ══════════════════════════════════════════════════════════
# Aplica a todo el sitio
# COOP: lo necesita el popup de login de Google en el portal.
# No lo cambies a "same-origin" a secas o se rompe la sesión.
# ══════════════════════════════════════════════════════════
/*
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), interest-cohort=()

# ══════════════════════════════════════════════════════════
# HTML · siempre revalidar para que un deploy se vea al instante
# ══════════════════════════════════════════════════════════
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# ══════════════════════════════════════════════════════════
# Imágenes e íconos · no cambian, caché de un año
# Si reemplazas compartir.jpg, renómbralo (compartir-2.jpg) y actualiza el meta,
# o el caché seguirá sirviendo el anterior.
# ══════════════════════════════════════════════════════════
/compartir.jpg
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/icon-192.png
  Cache-Control: public, max-age=31536000, immutable

/icon-512.png
  Cache-Control: public, max-age=31536000, immutable

# ══════════════════════════════════════════════════════════
# App instalable del portal · el service worker y el manifiesto
# siempre se revalidan para que cada cambio llegue a los teléfonos
# ══════════════════════════════════════════════════════════
/portal/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/portal/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/portal/app-*
  Cache-Control: public, max-age=604800

# ══════════════════════════════════════════════════════════
# Rastreo
# ══════════════════════════════════════════════════════════
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

# ══════════════════════════════════════════════════════════
# CSS, JS e imágenes · caché de un año.
# El CSS y el JS se enlazan con una huella de contenido al final
# (electi.css?v=abc12345) que build.py calcula en cada compilación.
# Cada vez que cambia el archivo cambia la URL, así que el navegador
# lo vuelve a descargar solo. Ya no hay que renombrar nada a mano ni
# pedirle a nadie que limpie la caché.
# ══════════════════════════════════════════════════════════
/assets/*
  Cache-Control: public, max-age=31536000, immutable
